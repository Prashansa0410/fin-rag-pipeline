HF_TOKEN=your_huggingface_token_here

DATABASE_URL=postgresql://postgres:password@localhost:5432/finresearch
REDIS_URL=redis://localhost:6379/0

ECONOMICAL_MODEL=meta-llama/Llama-3.2-3B-Instruct
STANDARD_MODEL=Qwen/Qwen3-4B-Instruct-2507
ADVANCED_MODEL=Qwen/Qwen2.5-72B-Instruct
FALLBACK_MODEL=meta-llama/Llama-3.2-3B-Instruct

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

MODEL_ROUTING_ENABLED=true
CACHE_ENABLED=true

MAX_UPLOAD_SIZE=10485760 # 10MB

RESPONSE_TOKEN_RESERVE=2000
TOKEN_SAFETY_MARGIN=500

RATE_LIMIT=30/minute
